                        <?php } else { ?>
                            <?= $this->escape($user_data->user_name) ?>
                        <?php } ?>, Prefix: <?= $this->escape($prefix) ?></h2></td>
                </tr>
                <?php
                $user_indices = array_values(array_filter((array)$indices, function($index) use ($prefix) {
                    return strpos($index->index, $prefix) === 0;
                }));
                usort($user_indices, function($a, $b) use ($parse_es_size) {
                    return $parse_es_size($b->{'store.size'}) <=> $parse_es_size($a->{'store.size'});
                });
                ?>
