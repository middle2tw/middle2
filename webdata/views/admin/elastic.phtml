$indices = Elastic::esQuery('/_cat/indices?format=json');
$parse_es_size = function($size_str) {
    if (preg_match('/^([0-9.]+)(kb|mb|gb|tb|b)?$/i', trim($size_str), $m)) {
        $n = floatval($m[1]);
        switch (strtolower($m[2])) {
            case 'kb': return $n * 1024;
            case 'mb': return $n * 1024 ** 2;
            case 'gb': return $n * 1024 ** 3;
            case 'tb': return $n * 1024 ** 4;
            default:   return $n;
        }
    }
    return 0;
};
?>
            <table class="table">
